{
    "name": "bitandblack/markdown-idml-converter",
    "description": "Convert Markdown into (parts of) Adobe InDesign Markup Language Files (IDML).",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Tobias Köngeter",
            "email": "hello@bitandblack.com",
            "homepage": "https://www.bitandblack.com"
        }
    ],
    "homepage": "https://www.idml.dev/en/markdown-to-idml-converter-php.html",
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/tobiaskoengeter"
        }
    ],
    "require": {
        "php": ">=8.2",
        "bitandblack/idml-creator": "^2.0 || ^3.0 || ^4.0"
    },
    "require-dev": {
        "ext-dom": "*",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "symfony/var-dumper": "^8.0",
        "symplify/easy-coding-standard": "^13.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://bitandblack.repo.packagist.com/wirbelwild/",
            "name": "private-packagist"
        }
    ],
    "autoload": {
        "psr-4": {
            "BitAndBlack\\MarkdownIdmlConverter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BitAndBlack\\MarkdownIdmlConverter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "php vendor/bin/phpstan analyse --configuration ./phpstan.neon --memory-limit=-1 --ansi",
        "phpunit": "php vendor/bin/phpunit --configuration ./phpunit.xml --colors=always",
        "refactor": "php vendor/bin/rector && php vendor/bin/ecs --fix"
    },
    "scripts-descriptions": {
        "phpstan": "Runs PHPStan over the src folder and the tests folder.",
        "phpunit": "Runs PHPUnit.",
        "refactor": "Runs tools to refactor the code."
    }
}
